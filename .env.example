# Inbound: source name -> shared HMAC secret. Replace these placeholders; never commit real values.
SIGNING_SECRETS={"stripe":"whsec_change_me"}
# Where verified events are delivered (comma-separated).
TARGET_URLS=https://example.com/webhooks
# Signs outbound deliveries so targets can verify the gateway.
OUTBOUND_SECRET=replace-with-another-long-random-secret
# Protects GET /deliveries.
ADMIN_KEY=replace-with-an-admin-key
# Unset = in-memory queue (single process, lost on restart).
REDIS_URL=redis://localhost:6379
MAX_ATTEMPTS=5
TOLERANCE_SECONDS=300
BACKOFF_BASE_MS=1000
BACKOFF_CAP_MS=60000
SEND_TIMEOUT_MS=5000
PORT=3000
